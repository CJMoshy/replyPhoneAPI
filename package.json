{
  "name": "reply-quick-phone-api",
  "version": "0.0.1",
  "description": "API for creating phone numbers",
  "devDependencies": {
    "@eslint/js": "*",
    "@types/cors": "*",
    "@types/express": "*",
    "@types/node": "*",
    "@types/supertest": "*",
    "@types/swagger-ui-express": "*",
    "@vitest/coverage-v8": "*",
    "concurrently": "*",
    "drizzle-kit": "^0.31.4",
    "eslint": "*",
    "eslint-config-typescript": "*",
    "nodemon": "*",
    "supertest": "*",
    "ts-node": "*",
    "typescript": "*",
    "typescript-eslint": "*",
    "vite-plugin-eslint": "*",
    "vitest": "*"
  },
  "dependencies": {
    "cors": "*",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.3",
    "express": "*",
    "globals": "^16.3.0",
    "postgres": "^3.4.7",
    "swagger-ui-express": "*",
    "tsoa": "*"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "ts-node src/server.ts"
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node build/src/server.js",
    "prebuild": "npm run swagger",
    "build": "tsc",
    "predev": "npm run swagger",
    "dev": "concurrently \"nodemon\" \"nodemon -x tsoa spec-and-routes\"",
    "swagger": "tsoa spec-and-routes",
    "pretest": "npm run swagger && npm run lint",
    "test": "vitest run --no-file-parallelism --testTimeout=3000 --coverage",
    "lint": "eslint test/**/*.[jt]s src/**/*.[jt]s --fix"
  }
}
